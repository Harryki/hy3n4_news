# Cloudflare Workers auth for wrangler dev with remote bindings (wrangler.toml remote=true)
# Get token: https://dash.cloudflare.com/profile/api-tokens -> Create Token -> Edit Cloudflare Workers
# Required scopes: Account - Workers Scripts:Edit, D1:Edit, Vectorize:Edit, AI:Read, Queues:Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
